---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 — Page Not Found</title>
    <meta name="description" content="The page you're looking for has been abducted. Return to base.">
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garant:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script is:inline>
        const theme = localStorage.getItem('theme') || 'mint';
        document.documentElement.setAttribute('data-theme', theme);
    </script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            background: var(--bg);
            color: var(--tx-1);
        }

        @media (hover: hover) and (pointer: fine) {
            html { cursor: none; }
        }

        body {
            font-family: 'DM Sans', sans-serif;
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: none;
            position: relative;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Atmospheric background (mirrors global.css) ── */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            background:
                radial-gradient(ellipse 60% 50% at 80% 10%, var(--ac-10) 0%, transparent 60%),
                radial-gradient(ellipse 40% 60% at 10% 80%, var(--hi-10) 0%, transparent 60%);
        }

        body::after {
            content: '';
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
            background-size: 80px 80px;
        }

        /* ── Stars ── */
        .stars {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
        }

        .star {
            position: absolute;
            background: var(--tx-3);
            border-radius: 50%;
            animation: twinkle infinite alternate;
        }

        @keyframes twinkle {
            0%   { opacity: 0.08; transform: scale(0.8); }
            100% { opacity: 0.45; transform: scale(1.2); }
        }

        /* ── Content ── */
        .content {
            position: relative;
            z-index: 10;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* ── Eyebrow label ── */
        .eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.58rem;
            font-weight: 500;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--ac);
            margin-bottom: 1.5rem;
            opacity: 0.8;
        }

        /* ── 404 heading ── */
        h1 {
            font-family: 'JetBrains Mono', monospace;
            font-size: clamp(6rem, 16vw, 12rem);
            font-weight: 500;
            line-height: 0.9;
            letter-spacing: -0.05em;
            color: var(--tx-1);
            position: relative;
            user-select: none;
            transition: transform 0.2s ease-out;
        }

        h1 em {
            font-style: normal;
            color: var(--ac);
        }

        /* ── Divider rule ── */
        .rule {
            width: 32px;
            height: 1px;
            background: var(--ac);
            opacity: 0.6;
            margin: 1.5rem auto;
        }

        /* ── Subtitle ── */
        .subtitle {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 300;
            letter-spacing: 0.04em;
            color: var(--tx-2);
            max-width: 340px;
            line-height: 1.7;
        }

        /* ── Actions ── */
        .actions {
            display: flex;
            gap: 0.75rem;
            margin-top: 2.5rem;
            flex-wrap: wrap;
            justify-content: center;
            z-index: 20;
        }

        /* Mirrors global.css .btn style */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.75rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.62rem;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            cursor: none;
            border: 1px solid transparent;
            background: transparent;
            transition: all 0.3s cubic-bezier(.23,.93,.45,1);
            text-decoration: none;
            min-height: 44px;
            white-space: nowrap;
        }

        .btn-primary {
            color: var(--bg);
            background: var(--ac);
            border-color: var(--ac);
        }
        .btn-primary:hover {
            background: var(--tx-1);
            border-color: var(--tx-1);
            transform: translateY(-1px);
        }

        .btn-secondary {
            color: var(--tx-2);
            border-color: var(--bd);
        }
        .btn-secondary:hover {
            color: var(--ac);
            border-color: var(--ac-dim);
            transform: translateY(-1px);
        }

        /* ── Hint text ── */
        .hint {
            position: fixed;
            bottom: 2.5rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.5rem;
            color: var(--tx-3);
            letter-spacing: 0.22em;
            pointer-events: none;
            text-transform: uppercase;
            z-index: 10;
        }

        /* ── UFO Cursor ── */
        #ufo-cursor {
            position: fixed;
            top: -60px;
            left: -60px;
            width: 80px;
            height: 80px;
            pointer-events: none;
            z-index: 9999;
            transform: translate(-50%, -50%);
            transition: transform 0.1s;
            opacity: 0.9;
        }

        /* ── Tractor beam ── */
        .tractor-beam {
            position: absolute;
            top: 38px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            background: linear-gradient(
                to bottom,
                color-mix(in srgb, var(--ac) 50%, transparent),
                transparent
            );
            clip-path: polygon(35% 0, 65% 0, 100% 100%, 0% 100%);
            opacity: 0;
            transition: all 0.3s cubic-bezier(.23,.93,.45,1);
            transform-origin: top center;
        }

        body.beaming .tractor-beam {
            width: 120px;
            height: 420px;
            opacity: 0.5;
            animation: beamPulse 0.8s infinite alternate;
            left: calc(50% - 60px);
            transform: none;
        }

        @keyframes beamPulse {
            0%   { opacity: 0.35; }
            100% { opacity: 0.6; }
        }

        body.abducting h1 {
            animation: abductText 2.8s forwards cubic-bezier(.23,.93,.45,1);
        }

        @keyframes abductText {
            0%   { transform: translateY(0) scale(1) rotate(0deg); opacity: 1; }
            20%  { transform: translateY(-12px) scale(0.97) rotate(-1deg); }
            50%  { transform: translateY(-60px) scale(0.85) rotate(2deg); opacity: 0.75; }
            80%  { transform: translateY(-140px) scale(0.55) rotate(-3deg); opacity: 0.4; }
            100% { transform: translateY(-280px) scale(0.1) rotate(5deg); opacity: 0; }
        }

        /* ── Game Modal ── */
        #game-modal {
            position: fixed;
            inset: 0;
            background: color-mix(in srgb, var(--bg) 92%, transparent);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            z-index: 200;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s cubic-bezier(.23,.93,.45,1);
        }

        #game-modal.visible {
            opacity: 1;
            pointer-events: all;
            cursor: default;
        }

        #game-modal.visible ~ #ufo-cursor { display: none; }

        .game-container {
            border: 1px solid var(--bd-ac);
            padding: 1.5rem;
            background: var(--bg-1);
            position: relative;
        }

        #game-canvas {
            background: var(--bg);
            border: 1px solid var(--bd);
            image-rendering: pixelated;
            display: block;
        }

        .game-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.62rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--tx-2);
        }

        #game-title { color: var(--ac); }

        .close-game {
            background: none;
            border: none;
            color: var(--tx-2);
            font-size: 1.1rem;
            cursor: pointer;
            font-family: inherit;
            transition: color 0.2s;
            padding: 0 0.25rem;
        }
        .close-game:hover { color: var(--ac); }

        .game-hint {
            margin-top: 0.75rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.5rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--tx-3);
            text-align: center;
        }

        .game-over-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-family: 'Cormorant Garant', serif;
            font-size: 2.5rem;
            font-weight: 300;
            font-style: italic;
            color: var(--ac);
            display: none;
            pointer-events: none;
            letter-spacing: 0.02em;
        }

        @media (max-width: 480px) {
            h1 { font-size: 6rem; }
            .actions { flex-direction: column; align-items: stretch; }
            .btn { justify-content: center; }
        }
    </style>
</head>
<body>

    <canvas id="ambient-canvas"></canvas>
    <div class="cursor-glow" id="cursor-glow"></div>

    <div class="stars" id="stars-container"></div>

    <div class="content" id="main-content">
        <p class="eyebrow">// error 404</p>
        <h1 id="the-404"><em>4</em>0<em>4</em></h1>
        <div class="rule"></div>
        <p class="subtitle">You've drifted into uncharted space. This page doesn't exist.</p>
        <div class="actions">
            <button class="btn btn-secondary" id="btn-tetris">Play Tetris</button>
            <button class="btn btn-secondary" id="btn-snake">Play Snake</button>
            <a href="/" class="btn btn-primary" id="home-btn">Return to Base</a>
        </div>
    </div>

    <p class="hint">Hold left click above the 404 to abduct it</p>

    <!-- UFO Cursor -->
    <div id="ufo-cursor">
        <svg viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <radialGradient id="domeGrad" cx="50%" cy="60%" r="50%">
                    <stop offset="0%" stop-color="var(--tx-1)" stop-opacity="0.18"/>
                    <stop offset="100%" stop-color="var(--ac)" stop-opacity="0.04"/>
                </radialGradient>
            </defs>
            <!-- Dome -->
            <path d="M 50 72 C 50 38, 110 38, 110 72" fill="url(#domeGrad)" stroke="var(--ac-dim)" stroke-width="1.5"/>
            <!-- Alien silhouette inside dome -->
            <circle cx="80" cy="60" r="9" fill="var(--ac)" opacity="0.5"/>
            <ellipse cx="76" cy="58" rx="2.5" ry="1.5" fill="var(--bg)" transform="rotate(-10 76 58)" opacity="0.8"/>
            <ellipse cx="84" cy="58" rx="2.5" ry="1.5" fill="var(--bg)" transform="rotate(10 84 58)" opacity="0.8"/>
            <!-- Saucer body -->
            <ellipse cx="80" cy="76" rx="56" ry="15" fill="var(--bg-2)" stroke="var(--bd-ac)" stroke-width="1.5"/>
            <ellipse cx="80" cy="73" rx="46" ry="10" fill="color-mix(in srgb, var(--bg-1) 90%, var(--ac) 10%)"/>
            <!-- Lights -->
            <circle cx="36" cy="77" r="3" fill="var(--ac-dim)">
                <animate attributeName="opacity" values="0.8;0.15;0.8" dur="1.1s" repeatCount="indefinite"/>
            </circle>
            <circle cx="56" cy="83" r="3" fill="var(--hi)">
                <animate attributeName="opacity" values="0.8;0.15;0.8" dur="0.9s" repeatCount="indefinite"/>
            </circle>
            <circle cx="80" cy="87" r="3.5" fill="var(--tx-1)">
                <animate attributeName="opacity" values="0.8;0.15;0.8" dur="1.3s" repeatCount="indefinite"/>
            </circle>
            <circle cx="104" cy="83" r="3" fill="var(--hi)">
                <animate attributeName="opacity" values="0.8;0.15;0.8" dur="0.85s" repeatCount="indefinite"/>
            </circle>
            <circle cx="124" cy="77" r="3" fill="var(--ac-dim)">
                <animate attributeName="opacity" values="0.8;0.15;0.8" dur="1.05s" repeatCount="indefinite"/>
            </circle>
            <!-- Bottom ridge -->
            <ellipse cx="80" cy="88" rx="24" ry="6" fill="var(--bg)" stroke="var(--ac-dim)" stroke-width="1"/>
        </svg>
        <div class="tractor-beam"></div>
    </div>

    <!-- Game Modal -->
    <div id="game-modal">
        <div class="game-container" style="position: relative;">
            <div class="game-header">
                <span id="game-title">// game</span>
                <span id="game-score">Score: 0</span>
                <button class="close-game" id="btn-close-game">&times;</button>
            </div>
            <canvas id="game-canvas" width="240" height="400"></canvas>
            <div id="game-over-msg" class="game-over-text">Game Over</div>
            <p class="game-hint">Arrow keys / WASD &mdash; Space to restart</p>
        </div>
    </div>

    <script>
        const rootStyles = getComputedStyle(document.documentElement);
        const getVar = (name, fallback) => rootStyles.getPropertyValue(name).trim() || fallback;

        // ── Stars ──
        const starsContainer = document.getElementById('stars-container');
        for (let i = 0; i < 120; i++) {
            const star = document.createElement('div');
            star.className = 'star';
            const size = Math.random() * 2 + 0.5;
            star.style.width  = `${size}px`;
            star.style.height = `${size}px`;
            star.style.left   = `${Math.random() * 100}%`;
            star.style.top    = `${Math.random() * 100}%`;
            star.style.animationDuration = `${Math.random() * 4 + 2}s`;
            star.style.animationDelay   = `${Math.random() * 3}s`;
            starsContainer.appendChild(star);
        }

        // ── UFO Cursor ──
        const cursor  = document.getElementById('ufo-cursor');
        const text404 = document.getElementById('the-404');
        const modal   = document.getElementById('game-modal');
        let mouseX = window.innerWidth  / 2;
        let mouseY = window.innerHeight / 2;
        let cursorX = mouseX, cursorY = mouseY;

        document.addEventListener('mousemove', e => { mouseX = e.clientX; mouseY = e.clientY; });

        function animateCursor() {
            if (modal.classList.contains('visible')) { requestAnimationFrame(animateCursor); return; }
            cursorX += (mouseX - cursorX) * 0.12;
            cursorY += (mouseY - cursorY) * 0.12;
            const tilt = (mouseX - cursorX) * 0.4;
            cursor.style.left      = `${cursorX}px`;
            cursor.style.top       = `${cursorY}px`;
            cursor.style.transform = `translate(-50%, -50%) rotate(${tilt}deg)`;
            requestAnimationFrame(animateCursor);
        }
        animateCursor();

        // ── 404 Parallax Repulsion ──
        document.addEventListener('mousemove', e => {
            if (isAbducting || modal.classList.contains('visible')) return;
            const rect    = text404.getBoundingClientRect();
            const centerX = rect.left + rect.width  / 2;
            const centerY = rect.top  + rect.height / 2;
            const deltaX  = e.clientX - centerX;
            const deltaY  = e.clientY - centerY;
            const dist    = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
            if (dist < 220 && dist > 0) {
                const factor = (220 - dist) / 220;
                text404.style.transform = `translate(${(deltaX / dist) * -18 * factor}px, ${(deltaY / dist) * -10 * factor}px)`;
            } else {
                text404.style.transform = 'translate(0, 0)';
            }
        });

        // ── Abduction Logic ──
        let abductionTimer, isAbducting = false;

        document.addEventListener('mousedown', e => {
            if (e.target.closest('.btn') || modal.classList.contains('visible')) return;
            document.body.classList.add('beaming');
            const rect        = text404.getBoundingClientRect();
            const textCenterX = rect.left + rect.width / 2;
            if (Math.abs(mouseX - textCenterX) < 180 && mouseY < rect.top + 40) {
                isAbducting = true;
                document.body.classList.add('abducting');
                abductionTimer = setTimeout(() => { window.location.href = '/'; }, 2700);
            }
        });

        document.addEventListener('mouseup', () => {
            document.body.classList.remove('beaming');
            if (isAbducting) {
                document.body.classList.remove('abducting');
                isAbducting = false;
                clearTimeout(abductionTimer);
                text404.style.animation = 'none';
                text404.offsetHeight;
                text404.style.animation = '';
            }
        });

        // ── Games Engine ──
        const canvas      = document.getElementById('game-canvas');
        const ctx         = canvas.getContext('2d');
        const scoreEl     = document.getElementById('game-score');
        const titleEl     = document.getElementById('game-title');
        const gameOverMsg = document.getElementById('game-over-msg');
        let currentGame = null;
        let animationId, score = 0, isGameOver = false;

        document.getElementById('btn-tetris').addEventListener('click', () => startGame('tetris'));
        document.getElementById('btn-snake').addEventListener('click',  () => startGame('snake'));
        document.getElementById('btn-close-game').addEventListener('click', () => {
            modal.classList.remove('visible');
            cancelAnimationFrame(animationId);
            currentGame = null;
        });

        function startGame(type) {
            currentGame = type;
            modal.classList.add('visible');
            titleEl.innerText = type === 'tetris' ? '// tetris' : '// snake';
            score = 0;
            scoreEl.innerText = 'Score: 0';
            isGameOver = false;
            gameOverMsg.style.display = 'none';
            cancelAnimationFrame(animationId);
            if (type === 'tetris') initTetris();
            else initSnake();
        }

        // ── TETRIS ──
        let arena, player, dropCounter = 0, dropInterval = 1000, lastTime = 0;

        function initTetris() {
            canvas.width = 240; canvas.height = 400;
            ctx.scale(20, 20);
            arena  = createMatrix(12, 20);
            player = { pos: { x: 0, y: 0 }, matrix: null };
            playerReset();
            updateTetris();
        }

        function createMatrix(w, h) {
            const m = [];
            while (h--) m.push(new Array(w).fill(0));
            return m;
        }

        function createPiece(type) {
            if (type === 'T') return [[0,0,0],[1,1,1],[0,1,0]];
            if (type === 'O') return [[2,2],[2,2]];
            if (type === 'L') return [[0,3,0],[0,3,0],[0,3,3]];
            if (type === 'J') return [[0,4,0],[0,4,0],[4,4,0]];
            if (type === 'I') return [[0,5,0,0],[0,5,0,0],[0,5,0,0],[0,5,0,0]];
            if (type === 'S') return [[0,6,6],[6,6,0],[0,0,0]];
            if (type === 'Z') return [[7,7,0],[0,7,7],[0,0,0]];
        }

        function drawMatrix(matrix, offset) {
            const colors = [
                null,
                getVar('--ac',          '#c9a96e'),
                getVar('--hi',          '#7ba7c2'),
                getVar('--term-green',  '#28c840'),
                getVar('--term-yellow', '#febc2e'),
                getVar('--term-red',    '#ff5f57'),
                getVar('--tx-1',        '#ede9e0'),
                getVar('--ac-dim',      '#8a7a65'),
            ];
            matrix.forEach((row, y) => {
                row.forEach((value, x) => {
                    if (value !== 0) {
                        ctx.fillStyle = colors[value];
                        ctx.fillRect(x + offset.x, y + offset.y, 1, 1);
                        ctx.strokeStyle = 'rgba(0,0,0,0.4)';
                        ctx.lineWidth = 0.05;
                        ctx.strokeRect(x + offset.x, y + offset.y, 1, 1);
                    }
                });
            });
        }

        function merge(arena, player) {
            player.matrix.forEach((row, y) =>
                row.forEach((val, x) => { if (val) arena[y + player.pos.y][x + player.pos.x] = val; })
            );
        }

        function collide(arena, player) {
            const m = player.matrix, o = player.pos;
            for (let y = 0; y < m.length; ++y)
                for (let x = 0; x < m[y].length; ++x)
                    if (m[y][x] && (arena[y + o.y] && arena[y + o.y][x + o.x]) !== 0) return true;
            return false;
        }

        function playerDrop() {
            player.pos.y++;
            if (collide(arena, player)) { player.pos.y--; merge(arena, player); playerReset(); arenaSweep(); }
            dropCounter = 0;
        }

        function playerMove(dir) { player.pos.x += dir; if (collide(arena, player)) player.pos.x -= dir; }

        function playerReset() {
            const pieces = 'ILJOTSZ';
            player.matrix = createPiece(pieces[pieces.length * Math.random() | 0]);
            player.pos.y  = 0;
            player.pos.x  = (arena[0].length / 2 | 0) - (player.matrix[0].length / 2 | 0);
            if (collide(arena, player)) { isGameOver = true; gameOverMsg.style.display = 'block'; }
        }

        function playerRotate(dir) {
            const pos = player.pos.x;
            let offset = 1;
            rotate(player.matrix, dir);
            while (collide(arena, player)) {
                player.pos.x += offset;
                offset = -(offset + (offset > 0 ? 1 : -1));
                if (offset > player.matrix[0].length) { rotate(player.matrix, -dir); player.pos.x = pos; return; }
            }
        }

        function rotate(matrix, dir) {
            for (let y = 0; y < matrix.length; ++y)
                for (let x = 0; x < y; ++x)
                    [matrix[x][y], matrix[y][x]] = [matrix[y][x], matrix[x][y]];
            if (dir > 0) matrix.forEach(row => row.reverse()); else matrix.reverse();
        }

        function arenaSweep() {
            let rowCount = 1;
            outer: for (let y = arena.length - 1; y >= 0; --y) {
                for (let x = 0; x < arena[y].length; ++x) if (arena[y][x] === 0) continue outer;
                const row = arena.splice(y, 1)[0].fill(0);
                arena.unshift(row); ++y;
                score += rowCount * 10; rowCount *= 2;
                scoreEl.innerText = `Score: ${score}`;
                dropInterval = Math.max(100, 1000 - score * 2);
            }
        }

        function updateTetris(time = 0) {
            if (currentGame !== 'tetris') return;
            if (!isGameOver) {
                const dt = time - lastTime; lastTime = time;
                dropCounter += dt;
                if (dropCounter > dropInterval) playerDrop();
                ctx.fillStyle = getVar('--bg', '#06060a');
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                drawMatrix(arena, { x: 0, y: 0 });
                drawMatrix(player.matrix, player.pos);
            }
            animationId = requestAnimationFrame(updateTetris);
        }

        // ── SNAKE ──
        let s_snake, s_food, s_dx, s_dy;
        const S_GRID = 10;
        const S_COLS = 240 / S_GRID;
        const S_ROWS = 400 / S_GRID;
        let s_lastTime = 0;

        function initSnake() {
            canvas.width = 240; canvas.height = 400;
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            s_snake = [{ x: 12, y: 20 }, { x: 12, y: 21 }, { x: 12, y: 22 }];
            s_dx = 0; s_dy = -1;
            placeFood();
            updateSnake();
        }

        function placeFood() {
            s_food = { x: Math.floor(Math.random() * S_COLS), y: Math.floor(Math.random() * S_ROWS) };
        }

        function updateSnake(time = 0) {
            if (currentGame !== 'snake') return;
            if (!isGameOver) {
                if (time - s_lastTime > 100) {
                    s_lastTime = time;
                    const head = { x: s_snake[0].x + s_dx, y: s_snake[0].y + s_dy };
                    if (head.x < 0 || head.x >= S_COLS || head.y < 0 || head.y >= S_ROWS ||
                        s_snake.some(seg => seg.x === head.x && seg.y === head.y)) {
                        isGameOver = true; gameOverMsg.style.display = 'block';
                    } else {
                        s_snake.unshift(head);
                        if (head.x === s_food.x && head.y === s_food.y) {
                            score += 10; scoreEl.innerText = `Score: ${score}`; placeFood();
                        } else { s_snake.pop(); }
                    }
                    ctx.fillStyle = getVar('--bg', '#06060a');
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    ctx.fillStyle = getVar('--ac', '#c9a96e');
                    ctx.fillRect(s_food.x * S_GRID, s_food.y * S_GRID, S_GRID, S_GRID);
                    s_snake.forEach((seg, i) => {
                        ctx.fillStyle = i === 0
                            ? getVar('--tx-1', '#ede9e0')
                            : getVar('--ac-dim', 'rgba(201,169,110,.45)');
                        ctx.fillRect(seg.x * S_GRID, seg.y * S_GRID, S_GRID - 1, S_GRID - 1);
                    });
                }
            }
            animationId = requestAnimationFrame(updateSnake);
        }

        // ── Controls ──
        document.addEventListener('keydown', e => {
            if (!modal.classList.contains('visible')) return;
            if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key)) e.preventDefault();
            if (isGameOver && e.key === ' ') { startGame(currentGame); return; }
            if (currentGame === 'tetris') {
                if      (e.key === 'ArrowLeft'  || e.key === 'a') playerMove(-1);
                else if (e.key === 'ArrowRight' || e.key === 'd') playerMove(1);
                else if (e.key === 'ArrowDown'  || e.key === 's') playerDrop();
                else if (e.key === 'ArrowUp'    || e.key === 'w') playerRotate(1);
            } else if (currentGame === 'snake') {
                if      ((e.key === 'ArrowLeft'  || e.key === 'a') && s_dx !==  1) { s_dx = -1; s_dy =  0; }
                else if ((e.key === 'ArrowRight' || e.key === 'd') && s_dx !== -1) { s_dx =  1; s_dy =  0; }
                else if ((e.key === 'ArrowUp'    || e.key === 'w') && s_dy !==  1) { s_dx =  0; s_dy = -1; }
                else if ((e.key === 'ArrowDown'  || e.key === 's') && s_dy !== -1) { s_dx =  0; s_dy =  1; }
            }
        });

        // ── Particle System ──
        (function initParticles() {
            const pCanvas = document.getElementById('ambient-canvas');
            const cursorGlowEl = document.getElementById('cursor-glow');
            if (!pCanvas) return;

            const isTouchDevice = () => window.matchMedia('(hover: none), (pointer: coarse)').matches;
            const isSmallScreen = () => window.innerWidth <= 480;
            if (isTouchDevice() || isSmallScreen()) { pCanvas.style.display = 'none'; return; }

            const hexToRgb = hex => {
                const h = hex.replace('#', '');
                return `${parseInt(h.slice(0,2),16)},${parseInt(h.slice(2,4),16)},${parseInt(h.slice(4,6),16)}`;
            };

            const pCtx = pCanvas.getContext('2d');
            let pParticles = [];
            let pRafId = null;
            const pMouse = { x: null, y: null, gx: 0, gy: 0, r: 110 };

            window.addEventListener('mousemove', e => { pMouse.x = e.clientX; pMouse.y = e.clientY; });
            window.addEventListener('mouseleave', () => { pMouse.x = null; pMouse.y = null; });

            const pResize = () => {
                pCanvas.width  = window.innerWidth;
                pCanvas.height = window.innerHeight;
                pInit();
            };

            class Particle {
                constructor() { this.pReset(); }
                pReset() {
                    this.x  = Math.random() * pCanvas.width;
                    this.y  = Math.random() * pCanvas.height;
                    this.vx = (Math.random() - .5) * .35;
                    this.vy = (Math.random() - .5) * .35;
                    this.r  = Math.random() * 2 + 1;
                    const style = getComputedStyle(document.documentElement);
                    const ac20 = style.getPropertyValue('--ac-20').trim() || 'rgba(201,169,110,.16)';
                    const hi10 = style.getPropertyValue('--hi-10').trim() || 'rgba(123,167,194,.08)';
                    const cs = [ac20, hi10, ac20];
                    this.c = cs[Math.floor(Math.random() * cs.length)];
                }
                update() {
                    this.x += this.vx;
                    this.y += this.vy;
                    if (this.x < 0 || this.x > pCanvas.width)  this.vx *= -1;
                    if (this.y < 0 || this.y > pCanvas.height) this.vy *= -1;
                    if (pMouse.x !== null) {
                        const dx = this.x - pMouse.x, dy = this.y - pMouse.y;
                        const d = Math.hypot(dx, dy);
                        if (d < 90) {
                            const f = (90 - d) / 90;
                            const a = Math.atan2(dy, dx);
                            this.x += Math.cos(a) * f * 1.2;
                            this.y += Math.sin(a) * f * 1.2;
                        }
                    }
                }
                draw() {
                    pCtx.beginPath();
                    pCtx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
                    pCtx.fillStyle = this.c;
                    pCtx.fill();
                }
            }

            const pInit = () => {
                pParticles = [];
                const density = window.innerWidth < 900 ? 35000 : 22000;
                const n = Math.min(Math.floor(pCanvas.width * pCanvas.height / density), 65);
                for (let i = 0; i < n; i++) pParticles.push(new Particle());
            };

            const drawEdges = () => {
                const style = getComputedStyle(document.documentElement);
                const acHex = style.getPropertyValue('--ac').trim() || '#c9a96e';
                const ac = hexToRgb(acHex);
                for (let i = 0; i < pParticles.length; i++) {
                    const p = pParticles[i];
                    if (pMouse.x !== null) {
                        const d = Math.hypot(p.x - pMouse.x, p.y - pMouse.y);
                        if (d < pMouse.r) {
                            pCtx.strokeStyle = `rgba(${ac},${(1 - d / pMouse.r) * .25})`;
                            pCtx.lineWidth = 1;
                            pCtx.beginPath();
                            pCtx.moveTo(p.x, p.y);
                            pCtx.lineTo(pMouse.x, pMouse.y);
                            pCtx.stroke();
                        }
                    }
                    for (let j = i + 1; j < pParticles.length; j++) {
                        const q = pParticles[j];
                        const d = Math.hypot(p.x - q.x, p.y - q.y);
                        if (d < 110) {
                            pCtx.strokeStyle = `rgba(${ac},${(1 - d / 110) * .15})`;
                            pCtx.lineWidth = .8;
                            pCtx.beginPath();
                            pCtx.moveTo(p.x, p.y); pCtx.lineTo(q.x, q.y);
                            pCtx.stroke();
                        }
                    }
                }
            };

            const pAnimate = () => {
                pCtx.clearRect(0, 0, pCanvas.width, pCanvas.height);
                pParticles.forEach(p => { p.update(); p.draw(); });
                drawEdges();

                if (cursorGlowEl && pMouse.x !== null) {
                    pMouse.gx += (pMouse.x - pMouse.gx) * .09;
                    pMouse.gy += (pMouse.y - pMouse.gy) * .09;
                    cursorGlowEl.style.transform = `translate3d(${pMouse.gx - 130}px,${pMouse.gy - 130}px,0)`;
                    cursorGlowEl.style.opacity = '1';
                } else if (cursorGlowEl) {
                    cursorGlowEl.style.opacity = '0';
                }

                pRafId = requestAnimationFrame(pAnimate);
            };

            window.addEventListener('resize', pResize, { passive: true });
            pResize();
            pAnimate();

            document.addEventListener('visibilitychange', () => {
                if (document.hidden) cancelAnimationFrame(pRafId);
                else pAnimate();
            });
        })();
    </script>
</body>
</html>
