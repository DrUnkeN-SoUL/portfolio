---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="404 — Mathews Shaji"
  description="Page not found."
>
  <main class="scanlines flex min-h-screen items-center justify-center bg-background px-5 font-mono text-foreground">
    <div class="w-full max-w-md">
      <p class="text-[0.65rem] tracking-[0.3em] text-muted-foreground">
        signal lost
      </p>
      <h1 class="mt-6 text-5xl tracking-tight">404</h1>
      <p class="mt-6 text-sm leading-7 text-muted-foreground">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="mt-10 inline-block text-sm underline underline-offset-4 hover:no-underline"
      >
        cd ~ →
      </a>
      <p class="mt-16 text-[0.65rem] tracking-[0.3em] text-muted-foreground">
        end of file
      </p>
    </div>
  </main>
</Layout>
