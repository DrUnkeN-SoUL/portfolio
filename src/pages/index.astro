---
import Layout from "@/layouts/Layout.astro";
import { AsciiPortrait } from "@/components/AsciiPortrait";
import { PixelNameMark } from "@/components/IntroName";
import ProjectRow from "@/components/ProjectRow.astro";
import { IntroOverlay } from "@/components/IntroOverlay";
import { bio, community, links, projects, roles } from "@/data/portfolio";

const title = "Mathews Shaji — Backend-leaning full-stack developer";
const description =
  "Mathews Shaji builds data pipelines, multi-tenant APIs and cloud infrastructure across AWS, GCP and Azure. Python, Go and Rust.";

const year = new Date().getFullYear();
---

<Layout title={title} description={description}>
  <main class="scanlines min-h-screen bg-background font-mono text-foreground">
    <IntroOverlay client:load />

    <div class="mx-auto max-w-6xl px-5 md:px-10">
      <header
        class="sticky top-0 z-40 grid grid-cols-[minmax(0,1fr)_auto] items-center bg-background py-6 text-xs tracking-[0.3em] text-muted-foreground"
      >
        <span class="reveal">
          <PixelNameMark client:load visible={true} />
        </span>
        <span class="reveal reveal-delay">ind · utc+5:30</span>
      </header>

      <section
        class="grid min-h-[calc(100svh-4rem)] grid-cols-1 content-center gap-10 py-6 md:grid-cols-[minmax(0,1.35fr)_minmax(15rem,0.65fr)] md:items-center md:gap-8 lg:gap-14"
      >
        <div class="reveal min-w-0 overflow-hidden">
          <AsciiPortrait client:load />
        </div>
        <div class="reveal reveal-delay min-w-0">
          <div class="mb-10 md:mb-12">
            <h1 class="text-xl md:text-[clamp(1.15rem,2.2vh,1.875rem)]">
              Mathews Shaji
            </h1>
            <p
              class="mt-2 text-[0.65rem] leading-relaxed tracking-[0.2em] text-muted-foreground"
            >
              backend-leaning full-stack developer
            </p>
          </div>
          <h2
            class="mb-10 text-xs lowercase tracking-[0.4em] text-muted-foreground"
          >
            biography
          </h2>
          <div
            class="max-w-xl text-[clamp(0.65rem,1.3vh,0.8rem)] leading-[1.8]"
          >
            {
              bio.map((line, i) =>
                line === "" ? (
                  <div class="h-3 md:h-[1.5vh]" />
                ) : (
                  <p>{line}</p>
                ),
              )
            }
          </div>
        </div>
      </section>

      <section class="py-24 md:py-32">
        <h2 class="mb-10 text-xs lowercase tracking-[0.4em] text-muted-foreground">
          journey
        </h2>
        <ul class="flex flex-col">
          {
            roles.map((role) => (
              <li class="grid grid-cols-1 gap-2 border-t border-border py-6 md:grid-cols-[12rem_1fr] md:gap-8">
                <span class="text-[0.7rem] tracking-[0.2em] text-muted-foreground">
                  {role.period}
                </span>
                <div class="flex flex-col gap-2">
                  <span class="text-sm">{role.title}</span>
                  <span class="text-xs text-muted-foreground">{role.org}</span>
                  <p class="max-w-prose text-xs leading-relaxed text-muted-foreground">
                    {role.line}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="py-24 md:py-32">
        <h2 class="mb-10 text-xs lowercase tracking-[0.4em] text-muted-foreground">
          projects
        </h2>
        <ul class="flex flex-col border-b border-border">
          {
            projects.map((project, i) => (
              <ProjectRow project={project} index={i} />
            ))
          }
        </ul>
      </section>

      <section class="py-24 md:py-32">
        <h2 class="mb-10 text-xs lowercase tracking-[0.4em] text-muted-foreground">
          community
        </h2>
        <ul class="flex flex-col">
          {
            community.map((item) => (
              <li class="grid grid-cols-[2rem_1fr] items-baseline gap-2 border-t border-border py-5">
                <span class="text-[0.65rem] text-muted-foreground">▸</span>
                <p class="max-w-prose text-xs leading-relaxed">{item}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="py-24 md:py-32">
        <h2 class="mb-10 text-xs lowercase tracking-[0.4em] text-muted-foreground">
          contact
        </h2>
        <p class="max-w-md text-sm leading-8">
          Open to backend, infrastructure and full-stack work.
        </p>
        <ul class="mt-8 flex flex-col gap-3 text-sm">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="underline underline-offset-4 hover:no-underline"
                >
                  {link.label} →
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <footer
        class="flex items-baseline justify-between border-t border-border py-8 text-[0.65rem] tracking-[0.3em] text-muted-foreground"
      >
        <span>© {year} mathews shaji</span>
        <span>end of file</span>
      </footer>
    </div>
  </main>
</Layout>
