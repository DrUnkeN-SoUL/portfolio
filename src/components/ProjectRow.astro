---
import type { Project } from "@/data/portfolio";

export interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<li class="border-t border-border">
  <details class="group">
    <summary
      class="grid w-full cursor-pointer list-none grid-cols-[3rem_1fr_auto] items-baseline gap-4 py-5 text-left [&::-webkit-details-marker]:hidden"
    >
      <span class="text-[0.65rem] text-muted-foreground">[{number}]</span>
      <span class="flex flex-col gap-1">
        <span class="text-xs uppercase tracking-[0.28em] text-muted-foreground">
          pr. name
        </span>
        <span class="text-base tracking-tight text-foreground group-hover:underline">
          {project.name}
        </span>
      </span>
      <span class="flex items-baseline gap-2 text-[0.65rem] text-muted-foreground">
        {project.year}
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-open:rotate-45"
        >
          +
        </span>
      </span>
    </summary>

    <div class="project-panel">
      <div
        class="grid grid-cols-1 gap-4 pb-8 pl-[3.75rem] pr-2 md:grid-cols-[1fr_1fr]"
      >
        <p class="max-w-prose text-xs leading-relaxed text-muted-foreground">
          <span class="mr-2 text-foreground">[/&gt; info</span>
          {project.info}
        </p>
        <div class="flex flex-col gap-2 text-xs text-muted-foreground">
          <span>client: {project.client}</span>
          <span>tech: {project.tech}</span>
          {
            project.url && (
              <a
                href={project.url}
                target="_blank"
                rel="noreferrer noopener"
                class="w-fit text-foreground underline underline-offset-4 hover:no-underline"
              >
                {project.urlLabel ?? project.url} →
              </a>
            )
          }
        </div>
      </div>
    </div>
  </details>
</li>
