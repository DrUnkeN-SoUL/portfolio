<style>
  .exp-sticky-panel {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg-1);
    border: 1px solid var(--bd);
  }

  .exp-sticky-header {
    padding: 2.25rem 2.5rem 1.25rem 2.5rem;
    border-bottom: 1px solid var(--bd);
    background: var(--bg-1);
  }

  .exp-content-row {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .exp-mobile-headers { display: none; }

  @media (max-width: 1024px) {
    .exp-mobile-headers { display: block; }
  }

  .exp-progress-bar {
    position: absolute;
    top: 0; left: 0;
    height: 2px;
    background: var(--ac);
    width: 0%;
    transition: width .1s linear;
    z-index: 10;
  }

  .exp-sidebar {
    width: 220px;
    flex-shrink: 0;
    border-right: 1px solid var(--bd);
    overflow-y: auto;
    padding: 2rem 0;
  }

  .exp-sidebar-item {
    padding: 1rem 1.5rem;
    cursor: pointer;
    border-left: 2px solid transparent;
    transition: border-color .25s var(--ease), background .25s var(--ease);
  }
  .exp-sidebar-item:hover { border-left-color: var(--ac-dim); }
  .exp-sidebar-item.active {
    border-left-color: var(--ac);
    background: var(--ac-10);
  }

  .exp-sidebar-year {
