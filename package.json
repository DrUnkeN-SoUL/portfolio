{
  "name": "mathews-portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:portfolio": "bun run --filter mathews-portfolio dev",
    "dev:blog": "bun run --filter mathews-blog dev",
    "build": "bun run build:portfolio && bun run build:blog",
    "build:portfolio": "bun run --filter mathews-portfolio build",
    "build:blog": "bun run --filter mathews-blog build",
    "lint": "eslint apps packages",
    "format": "prettier --write .",
    "check:content": "bun run --filter mathews-blog check:content",
    "new-post": "bun run --filter mathews-blog new-post"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
